# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# File .env berisi rahasia, jangan di-commit ke git (sudah masuk .gitignore).

# Akun guru/admin (WAJIB). Sandi minimal 8 karakter.
ADMIN_USER=
ADMIN_PASSWORD=

# Port server (opsional, default 3000). Di VM gunakan 443 untuk HTTPS.
PORT=3000

# Zona waktu untuk menentukan "hari ini" (opsional, default Asia/Jakarta)
TZ=Asia/Jakarta
